[Unit]
Description=OpenUU hbbs
After=network-online.target
Wants=network-online.target
[Service]
User=openuu
Group=openuu
WorkingDirectory=/var/lib/openuu-server
Environment=OPENUU_ACCOUNT_DB=/var/lib/openuu-server/openuu-accounts.sqlite3
Environment=OPENUU_ACCOUNT_BIND=0.0.0.0:21114
ExecStart=/opt/openuu-server/bin/hbbs -r rs.example.com:21117 -k _
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
